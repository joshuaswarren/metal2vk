// shuffles on scalars use the subgroup builtins; vector types go element by element
#define M2V_SHUF(NAME, BUILTIN, ARG)                                                                                   \
  template <typename T> METAL_FUNC enable_if_t<__is_arithmetic(T), T> NAME(T x, ushort a) { return BUILTIN(x, (uint)a); } \
  template <typename V> METAL_FUNC enable_if_t<!__is_arithmetic(V), V> NAME(V x, ushort a) {                                \
    V r;                                                                                                               \
    for (int i = 0; i < (int)__builtin_vectorelements(V); i++) r[i] = BUILTIN(x[i], (uint)a);                          \
    return r;                                                                                                          \
  }
M2V_SHUF(simd_shuffle, sub_group_shuffle, lane)
M2V_SHUF(simd_shuffle_xor, sub_group_shuffle_xor, mask)
M2V_SHUF(simd_broadcast, sub_group_broadcast, lane)
template <typename T> METAL_FUNC T simd_broadcast_first(T x) { return simd_broadcast(x, (ushort)0); }

// ---- simdgroup_matrix<T, 8, 8>, Apple fragment layout: lane -> (row, col0, col0 + 1), two elements per lane ----
METAL_FUNC int m2v_row(uint lane) { return (int)(((lane >> 4) & 1) * 4 + ((lane >> 1) & 3)); }
METAL_FUNC int m2v_col(uint lane) { return (int)(((lane >> 3) & 1) * 4 + (lane & 1) * 2); }
METAL_FUNC uint m2v_lane_of(int r, int c0) {
  return (uint)(((c0 >> 1) & 1) | ((r & 3) << 1) | (((c0 >> 2) & 1) << 3) | (((r >> 2) & 1) << 4));
}

template <typename T, int R, int C> struct simdgroup_matrix {
  vec<T, 2> el;
  METAL_FUNC simdgroup_matrix() = default;
  // Copy operations are __private-qualified: these matrices are thread-private, and the implicit operations would
  // take their argument through the generic address space, which clspv cannot rebuild for whole-matrix accesses.
  METAL_FUNC simdgroup_matrix(const __private simdgroup_matrix& o) : el(o.el) {}
  METAL_FUNC simdgroup_matrix(const simdgroup_matrix& o) : el(o.el) {}
  // Materialized temporaries carry no address space, so the copy operations need both spellings.
  METAL_FUNC __private simdgroup_matrix& operator=(const simdgroup_matrix& o) __private {
    el = o.el;
    return *this;
  }
  METAL_FUNC __private simdgroup_matrix& operator=(const __private simdgroup_matrix& o) __private {
    el = o.el;
    return *this;
  }
  // Metal: simdgroup_matrix(value) is the diagonal matrix value * I.
  METAL_FUNC simdgroup_matrix(T v) {
    const uint lane = get_sub_group_local_id();
    const int r = m2v_row(lane), c = m2v_col(lane);
    el[0] = r == c ? v : T(0);
    el[1] = r == c + 1 ? v : T(0);
  }
  METAL_FUNC __private vec<T, 2>& thread_elements() __private { return el; }
};

#ifdef M2V_NO_COOPMAT
// Portable fallback: D = A * B + C with subgroup shuffles in the Apple fragment layout (any 32-wide subgroup device).
template <typename TD, typename TA, typename TB, typename TC>
METAL_FUNC void simdgroup_multiply_accumulate(
    simdgroup_matrix<TD, 8, 8>& D, simdgroup_matrix<TA, 8, 8>& A, simdgroup_matrix<TB, 8, 8>& B,
    simdgroup_matrix<TC, 8, 8>& Cm) {
  const uint lane = get_sub_group_local_id();
  const int row = m2v_row(lane);
  const int col = m2v_col(lane);
  float acc0 = (float)Cm.el[0];
  float acc1 = (float)Cm.el[1];
  for (int k = 0; k < 8; k++) {
    const float a = sub_group_shuffle((float)A.el[k & 1], m2v_lane_of(row, k & ~1));
    const uint src_b = m2v_lane_of(k, col);
    const float b0 = sub_group_shuffle((float)B.el[0], src_b);
    const float b1 = sub_group_shuffle((float)B.el[1], src_b);
    acc0 = ::fma(a, b0, acc0);
    acc1 = ::fma(a, b1, acc1);
  }
  D.el[0] = (TD)acc0;
  D.el[1] = (TD)acc1;
}
#else
} // namespace metal
// Lowered by the patched clspv (clspv-patches/apply-coopmat-lowering.py) to OpCooperativeMatrixMulAddKHR. Honeykrisp's 8x8
// coopmat fragment layout equals Apple's simdgroup_matrix layout (probes/layout-run.py), so two elements per lane map 1:1.
extern "C" float2 m2v_mma_f32(float2 a, float2 b, float2 c) __attribute__((convergent, const));
namespace metal {
template <typename TD, typename TA, typename TB, typename TC>
METAL_FUNC void simdgroup_multiply_accumulate(
    simdgroup_matrix<TD, 8, 8>& D, simdgroup_matrix<TA, 8, 8>& A, simdgroup_matrix<TB, 8, 8>& B,
    simdgroup_matrix<TC, 8, 8>& Cm) {
  const float2 r = m2v_mma_f32(float2{(float)A.el[0], (float)A.el[1]}, float2{(float)B.el[0], (float)B.el[1]},
                               float2{(float)Cm.el[0], (float)Cm.el[1]});
  D.el[0] = (TD)r.x;
  D.el[1] = (TD)r.y;
}
#ifdef M2V_F16_COOPMAT
} // namespace metal
// half A and B with an f32 accumulator: lowered to the f16/f16/f32 8x8x8 cooperative matrix shape (clspv-patches/apply-coopmat-f16.py).
extern "C" float2 m2v_mma_f16(half2 a, half2 b, float2 c) __attribute__((convergent, const));
namespace metal {
template <typename TD, typename TC>
METAL_FUNC void simdgroup_multiply_accumulate(
    simdgroup_matrix<TD, 8, 8>& D, simdgroup_matrix<half, 8, 8>& A, simdgroup_matrix<half, 8, 8>& B,
    simdgroup_matrix<TC, 8, 8>& Cm) {
  const float2 r = m2v_mma_f16(A.el, B.el, float2{(float)Cm.el[0], (float)Cm.el[1]});
  D.el[0] = (TD)r.x;
  D.el[1] = (TD)r.y;
}
