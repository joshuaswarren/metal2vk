// metal_stdlib shim: lets Metal Shading Language compute kernels compile as C++ for OpenCL, for clspv (Vulkan SPIR-V).
//  - address spaces device/threadgroup/constant/thread map to OpenCL's __global/__local/__constant/__private
//  - simd_* map to sub_group_* (subgroup size 32, the Apple GPU simdgroup width)
//  - simdgroup_matrix<T,8,8> has Apple's per-lane layout (2 elements per lane); simdgroup_multiply_accumulate is lowered
//    by the patched clspv to VK_KHR_cooperative_matrix (same layout on Honeykrisp), or emulated with shuffles when
//    M2V_NO_COOPMAT is defined.
#pragma once
#pragma OPENCL EXTENSION cl_khr_fp16 : enable

#define device __global
#define threadgroup __local
#define constant __constant
// `thread` expands to nothing: with the generic address space disabled (-cl-ext=-__opencl_c_generic_address_space) an
// unqualified object, pointer or `this` is private, which is what Metal's `thread` means; an explicit __private on a
// constructor or method makes it unusable for unqualified temporaries.
#define thread
#define METAL_FUNC inline __attribute__((always_inline))
#ifndef FLT_MAX
#define FLT_MAX 3.402823466e+38f
#endif
#define M2V_SUBGROUP 32

