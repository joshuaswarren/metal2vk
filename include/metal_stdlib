// ---- bfloat16 as a storage type with exact widening, round-to-nearest-even narrowing ----
struct bfloat {
  ushort bits;
  METAL_FUNC bfloat() = default;
  METAL_FUNC bfloat(float f) {
    const uint u = as_uint(f);
    bits = (ushort)((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);
  }
  template <typename U> METAL_FUNC bfloat(U v) : bfloat((float)v) {}
  METAL_FUNC operator float() const { return as_float((uint)bits << 16); }
};

template <typename T, typename U> METAL_FUNC T as_type(U u) { return __builtin_bit_cast(T, u); }

enum mem_flags { mem_none = 0, mem_device = 1, mem_threadgroup = 2, mem_threadgroup_imageblock = 4 };
METAL_FUNC void threadgroup_barrier(mem_flags f) { barrier((f & mem_device) ? CLK_GLOBAL_MEM_FENCE : CLK_LOCAL_MEM_FENCE); }
METAL_FUNC void simdgroup_barrier(mem_flags) { sub_group_barrier(CLK_LOCAL_MEM_FENCE); }

