// ---- bfloat16: Metal's 16-bit float storage with exact widening, round-to-nearest-even narrowing ----
#if defined(__clang__) && __clang_major__ >= 20
// clang 20+ gives SPIR a real arithmetic __bf16, so Metal's promotion rules hold exactly: a conditional of
// bfloat and float is float, arithmetic promotes to float, float->bfloat narrows round-to-nearest-even. clspv
// rejects the LLVM bfloat type, so sweep/bfloat_to_i16.py retypes the module to i16 before clspv.
typedef __bf16 bfloat;
#else
// Storage struct on older clangs. Both implicit conversions (float->bfloat ctor, bfloat->float operator) mean
// `c ? bfloat : float` is ambiguous here - the conditional rule needs the real type above.
struct bfloat {
  ushort bits;
  METAL_FUNC bfloat() = default;
  METAL_FUNC bfloat(float f) {
    const uint u = as_uint(f);
    bits = (ushort)((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);
  }
  template <typename U> METAL_FUNC bfloat(U v) : bfloat((float)v) {}
  METAL_FUNC operator float() const { return as_float((uint)bits << 16); }
  METAL_FUNC operator float() const __constant { return as_float((uint)bits << 16); }
};
#endif

// Same finite set as float (8-bit exponent, 7-bit mantissa), built from raw bit patterns: max 0x7F7F, smallest
// normal 0x0080, epsilon 0x3C00 (2^-7), denorm_min 0x0001, infinity 0x7F80, quiet NaN 0x7FC0.
template <> struct numeric_limits<bfloat> {
  static bfloat from_bits(ushort b) { bfloat r; r.bits = b; return r; }
  static bfloat max() { return from_bits(0x7F7F); }
  static bfloat min() { return from_bits(0x0080); }
  static bfloat lowest() { return from_bits(0xFF7F); }
  static bfloat epsilon() { return from_bits(0x3C00); }
  static bfloat denorm_min() { return from_bits(0x0001); }
  static bfloat infinity() { return from_bits(0x7F80); }
  static bfloat quiet_NaN() { return from_bits(0x7FC0); }
  static constexpr bool has_infinity = true;
  static constexpr bool has_quiet_NaN = true;
};

// vec<bfloat, N> stores raw i16 at the IR level: aggregate copies of bfloat-struct elements hit pointer-shape passes
// in clspv that cannot walk a struct element, while plain i16 copies compile everywhere. The copy constructor and
// assignment are user provided so every copy from a device pointer becomes typed member loads instead of a memcpy
// through the generic address space. The element interface keeps bfloat semantics, including round-to-nearest-even
// narrowing on every write.
template <int N> struct vec_sel<bfloat, N, false> {
  struct type {
    ushort v[N];
    static constexpr int m2v_n = N;
    METAL_FUNC type() = default;
    METAL_FUNC type(const type& o) { for (int i = 0; i < N; i++) v[i] = o.v[i]; }
    METAL_FUNC type& operator=(const type& o) { for (int i = 0; i < N; i++) v[i] = o.v[i]; return *this; }
    METAL_FUNC type(bfloat s) { for (int i = 0; i < N; i++) v[i] = s.bits; }
    template <typename E, typename = decltype(E{}[0])> METAL_FUNC type(E x) {
      for (int i = 0; i < N; i++) v[i] = bfloat((float)x[i]).bits;
    }
    METAL_FUNC bfloat operator[](int i) const { bfloat r; r.bits = v[i]; return r; }
    // A ref constructed from a float carries the round-to-nearest-even value instead of referencing storage, so
    // templates whose T is deduced from a non const operator[] call can return static_cast<T>(float).
    struct ref {
      ushort* slot;
      ushort bits;
      METAL_FUNC ref(ushort* s, ushort b) : slot(s), bits(b) {}
      METAL_FUNC ref(float f) : slot(nullptr), bits(bfloat(f).bits) {}
      METAL_FUNC operator bfloat() const { bfloat r; r.bits = slot ? *slot : bits; return r; }
      METAL_FUNC operator float() const { return as_float((uint)(slot ? *slot : bits) << 16); }
      METAL_FUNC ref& operator=(bfloat b) { if (slot) *slot = b.bits; else bits = b.bits; return *this; }
      METAL_FUNC ref& operator=(float f) { return *this = bfloat(f); }
    };
    METAL_FUNC ref operator[](int i) { return ref{&v[i], 0}; }
  };
};

