// ---- vectors: native ext_vector for arithmetic element types, a plain struct otherwise (bfloat) ----
template <typename T, int N, bool Native = __is_arithmetic(T)> struct vec_sel { using type = T __attribute__((ext_vector_type(N))); };
template <typename T, int N> struct vec_sel<T, N, false> {
  struct type {
    T v[N];
    static constexpr int m2v_n = N;
    METAL_FUNC type() = default;
    METAL_FUNC type(T s) { for (int i = 0; i < N; i++) v[i] = s; }
    template <typename E, typename = decltype(E{}[0])> METAL_FUNC type(E x) { for (int i = 0; i < N; i++) v[i] = T(x[i]); }
    METAL_FUNC T& operator[](int i) { return v[i]; }
    METAL_FUNC const T& operator[](int i) const { return v[i]; }
    // Widening to the native float vector (Metal casts bfloat vectors elementwise). The object often lives in another
    // address space (a device buffer reinterpret), so every qualified spelling is needed.
#define M2V_VEC_CONV(AS) METAL_FUNC operator typename vec_sel<float, N>::type() const AS { \
    typename vec_sel<float, N>::type r; for (int i = 0; i < N; i++) r[i] = (float)v[i]; return r; }
    M2V_VEC_CONV()
    M2V_VEC_CONV(__global)
    M2V_VEC_CONV(__local)
    M2V_VEC_CONV(__constant)
#undef M2V_VEC_CONV
  };
};
// `vec` must stay a directly deducible alias: Apple's vec<T, N> is a class template, so kernels deduce through it
// (nax.h's frag_get(thread frag<T>&, ...), uzu's ThreadVector<U>). `typename vec_sel<T, N>::type` is a non-deduced
// context, which broke every such template. On clang 20+ bfloat is the arithmetic __bf16, so every instantiation is
// the native vector and the alias can name it outright. (The clang 19 struct fallback keeps the vec_sel spelling.)
#if defined(__clang__) && __clang_major__ >= 20
template <typename T, int N> using vec = T __attribute__((ext_vector_type(N)));
#else
template <typename T, int N> using vec = typename vec_sel<T, N>::type;
#endif
template <typename T, int N> using packed_vec = vec<T, N>;
typedef vec<short, 2> bool2;
typedef vec<short, 3> bool3;
typedef vec<short, 4> bool4;
typedef vec<char, 4> packed_char4;
typedef vec<unsigned char, 4> packed_uchar4;
typedef vec<short, 4> packed_short4;
typedef vec<int, 4> packed_int4;
// OpenCL uint3 has 16-byte size/alignment; Metal packed_uint3 is 12 bytes
// aligned to a scalar. Keep its storage layout explicit for 12-byte strides.
// Storage and indexing only: no vector arithmetic on this type.
// Scalar uint storage intentionally keeps copies trivial. Indexing requires i in [0, 2], as in Metal.
struct packed_uint3 {
  uint values[3];
#define M2V_PACKED_UINT3_INDEX(AS) \
  METAL_FUNC uint operator[](int i) const AS { return values[i]; }
  M2V_PACKED_UINT3_INDEX()
  M2V_PACKED_UINT3_INDEX(__global)
  M2V_PACKED_UINT3_INDEX(__constant)
  M2V_PACKED_UINT3_INDEX(__local)
#undef M2V_PACKED_UINT3_INDEX
};
static_assert(sizeof(packed_uint3) == 12 && alignof(packed_uint3) == 4,
              "packed_uint3 must retain scalar-aligned three-word storage");
typedef vec<uint, 4> packed_uint4;
typedef vec<float, 2> packed_float2;
typedef vec<float, 4> packed_float4;
typedef vec<half, 2> packed_half2;
typedef vec<half, 4> packed_half4;

// ---- bfloat16: Metal's 16-bit float storage with exact widening, round-to-nearest-even narrowing ----
#if defined(__clang__) && __clang_major__ >= 20
// clang 20+ gives SPIR a real arithmetic __bf16, so Metal's promotion rules hold exactly: a conditional of
// bfloat and float is float, arithmetic promotes to float, float->bfloat narrows round-to-nearest-even. clspv
// rejects the LLVM bfloat type, so sweep/bfloat_to_i16.py retypes the module to i16 before clspv.
typedef __bf16 bfloat;
#else
#define M2V_BFLOAT_STRUCT 1
// Storage struct on older clangs. Both implicit conversions (float->bfloat ctor, bfloat->float operator) mean
// `c ? bfloat : float` is ambiguous here - the conditional rule needs the real type above.
struct bfloat {
  ushort bits;
  METAL_FUNC bfloat() = default;
  // constexpr: MLX's complex.h evaluates complex arithmetic on bfloat16_t in static_asserts (mlx-core);
  // __builtin_bit_cast is constant-evaluable, as_uint/as_float are not.
  constexpr METAL_FUNC bfloat(float f)
      : bits((__builtin_bit_cast(uint, f) + 0x7fffu + ((__builtin_bit_cast(uint, f) >> 16) & 1u)) >> 16) {}
  constexpr METAL_FUNC bfloat(float f) __constant
      : bits((__builtin_bit_cast(uint, f) + 0x7fffu + ((__builtin_bit_cast(uint, f) >> 16) & 1u)) >> 16) {}
  template <typename U> METAL_FUNC bfloat(U v) : bfloat((float)v) {}
  constexpr METAL_FUNC operator float() const { return __builtin_bit_cast(float, (uint)bits << 16); }
  constexpr METAL_FUNC operator float() const __constant { return __builtin_bit_cast(float, (uint)bits << 16); }
};
#endif

// Same finite set as float (8-bit exponent, 7-bit mantissa), built from raw bit patterns: max 0x7F7F, smallest
// normal 0x0080, epsilon 0x3C00 (2^-7), denorm_min 0x0001, infinity 0x7F80, quiet NaN 0x7FC0.
template <> struct numeric_limits<bfloat> {
  static constexpr bfloat from_bits(ushort b) { return __builtin_bit_cast(bfloat, b); }
  static constexpr bfloat max() { return from_bits(0x7F7F); }
  static constexpr bfloat min() { return from_bits(0x0080); }
  static constexpr bfloat lowest() { return from_bits(0xFF7F); }
  static constexpr bfloat epsilon() { return from_bits(0x3C00); }
  static constexpr bfloat denorm_min() { return from_bits(0x0001); }
  static constexpr bfloat infinity() { return from_bits(0x7F80); }
  static constexpr bfloat quiet_NaN() { return from_bits(0x7FC0); }
  static constexpr bool has_infinity = true;
  static constexpr bool has_quiet_NaN = true;
};

// vec<bfloat, N> stores raw i16 at the IR level: aggregate copies of bfloat-struct elements hit pointer-shape passes
// in clspv that cannot walk a struct element, while plain i16 copies compile everywhere. The copy constructor and
// assignment are user provided so every copy from a device pointer becomes typed member loads instead of a memcpy
// through the generic address space. The element interface keeps bfloat semantics, including round-to-nearest-even
// narrowing on every write.
#ifdef M2V_BFLOAT_STRUCT
template <int N> struct vec_sel<bfloat, N, false> {
  struct type {
    ushort v[N];
    static constexpr int m2v_n = N;
    METAL_FUNC type() = default;
    METAL_FUNC type(const type& o) { for (int i = 0; i < N; i++) v[i] = o.v[i]; }
    METAL_FUNC type& operator=(const type& o) { for (int i = 0; i < N; i++) v[i] = o.v[i]; return *this; }
    METAL_FUNC type(bfloat s) { for (int i = 0; i < N; i++) v[i] = s.bits; }
    template <typename E, typename = decltype(E{}[0])> METAL_FUNC type(E x) {
      for (int i = 0; i < N; i++) v[i] = bfloat((float)x[i]).bits;
    }
    METAL_FUNC bfloat operator[](int i) const { bfloat r; r.bits = v[i]; return r; }
    // A ref constructed from a float carries the round-to-nearest-even value instead of referencing storage, so
    // templates whose T is deduced from a non const operator[] call can return static_cast<T>(float).
    struct ref {
      ushort* slot;
      ushort bits;
      METAL_FUNC ref(ushort* s, ushort b) : slot(s), bits(b) {}
      METAL_FUNC ref(float f) : slot(nullptr), bits(bfloat(f).bits) {}
      METAL_FUNC operator bfloat() const { bfloat r; r.bits = slot ? *slot : bits; return r; }
      METAL_FUNC operator float() const { return as_float((uint)(slot ? *slot : bits) << 16); }
      METAL_FUNC ref& operator=(bfloat b) { if (slot) *slot = b.bits; else bits = b.bits; return *this; }
      METAL_FUNC ref& operator=(float f) { return *this = bfloat(f); }
    };
    METAL_FUNC ref operator[](int i) { return ref{&v[i], 0}; }
  };
};
#endif

template <typename T, typename U> METAL_FUNC T as_type(U u) { return __builtin_bit_cast(T, u); }

