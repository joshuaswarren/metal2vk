// shuffles on scalars use the subgroup builtins; vector types go element by element
#define M2V_SHUF(NAME, BUILTIN, ARG)                                                                                   \
  template <typename T> METAL_FUNC enable_if_t<__is_arithmetic(T), T> NAME(T x, ushort a) { return BUILTIN(x, (uint)a); } \
  template <typename V> METAL_FUNC enable_if_t<!__is_arithmetic(V), V> NAME(V x, ushort a) {                                \
    V r;                                                                                                               \
    for (int i = 0; i < (int)__builtin_vectorelements(V); i++) r[i] = BUILTIN(x[i], (uint)a);                          \
    return r;                                                                                                          \
  }
