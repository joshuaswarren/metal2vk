// ---- vectors: native ext_vector for arithmetic element types, a plain struct otherwise (bfloat) ----
template <typename T, int N, bool Native = __is_arithmetic(T)> struct vec_sel { using type = T __attribute__((ext_vector_type(N))); };
template <typename T, int N> struct vec_sel<T, N, false> {
  struct type {
    T v[N];
    static constexpr int m2v_n = N;
    METAL_FUNC type() = default;
    METAL_FUNC type(T s) { for (int i = 0; i < N; i++) v[i] = s; }
    template <typename E, typename = decltype(E{}[0])> METAL_FUNC type(E x) { for (int i = 0; i < N; i++) v[i] = T(x[i]); }
    METAL_FUNC T& operator[](int i) { return v[i]; }
    METAL_FUNC const T& operator[](int i) const { return v[i]; }
    // Widening to the native float vector (Metal casts bfloat vectors elementwise). The object often lives in another
    // address space (a device buffer reinterpret), so every qualified spelling is needed.
#define M2V_VEC_CONV(AS) METAL_FUNC operator typename vec_sel<float, N>::type() const AS { \
    typename vec_sel<float, N>::type r; for (int i = 0; i < N; i++) r[i] = (float)v[i]; return r; }
    M2V_VEC_CONV()
    M2V_VEC_CONV(__global)
    M2V_VEC_CONV(__local)
    M2V_VEC_CONV(__constant)
#undef M2V_VEC_CONV
  };
};
template <typename T, int N> using vec = typename vec_sel<T, N>::type;
template <typename T, int N> using packed_vec = vec<T, N>;
