template <typename T> using remove_const_t = typename remove_const<T>::type;
template <typename T> struct remove_cv { using type = T; };
template <typename T> struct remove_cv<const T> { using type = T; };
// Metal's remove_addrspace_t: strip a trailing address-space qualifier (device bfloat -> bfloat).
template <typename T> struct remove_addrspace { using type = T; };
template <typename T> struct remove_addrspace<__global T> { using type = T; };
template <typename T> struct remove_addrspace<__local T> { using type = T; };
