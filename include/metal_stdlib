// ---- matrix<T, C, R>: MSL's register-resident column-major matrix, C columns of R-element vectors ----
// ggml's mul_mm / mul_mv_ext / flash-attn families stage tiles through float4x4 / half2x4 / bfloat4x4 and reinterpret
// device or threadgroup buffers as them, so the storage is a plain aggregate of column vectors (float4x4 lays out and
// aligns like four float4 columns, as MSL specifies). Copies and conversions are element loops: an aggregate struct
// copy crosses address spaces as one whole-object memcpy, the exact pointer shape clspv cannot rebuild (the same
// reason vec<bfloat, N> carries user copy operations).
template <typename T, int C, int R> struct matrix {
  vec<T, R> c[C];
  METAL_FUNC matrix() = default;
  METAL_FUNC matrix(const matrix& o) {
    for (int i = 0; i < C; i++)
      for (int j = 0; j < R; j++) c[i][j] = o.c[i][j];
  }
  METAL_FUNC matrix& operator=(const matrix& o) {
    for (int i = 0; i < C; i++)
      for (int j = 0; j < R; j++) c[i][j] = o.c[i][j];
    return *this;
  }
  // Metal's C-style cast between matrix types is elementwise ((float4x4) half4x4, (float4x4) bfloat4x4). Every
  // element routes through float: half and bfloat widen to float exactly, so only the final narrowing rounds, which
  // is Metal's promotion order.
  template <typename U> METAL_FUNC matrix(const matrix<U, C, R>& o) {
    for (int i = 0; i < C; i++)
      for (int j = 0; j < R; j++) c[i][j] = (T)(float)o.c[i][j];
  }
  METAL_FUNC vec<T, R>& operator[](int i) { return c[i]; }
  METAL_FUNC const vec<T, R>& operator[](int i) const { return c[i]; }
  // m * s keeps the matrix element type (ggml: (half2x4)(device_tile * (T1) s1_inv)).
  template <typename U> METAL_FUNC matrix operator*(U s) const {
    matrix r;
    for (int i = 0; i < C; i++)
      for (int j = 0; j < R; j++) r.c[i][j] = c[i][j] * s;
    return r;
  }
};
template <typename T, int C, int R, typename U>
METAL_FUNC matrix<T, C, R> operator*(U s, const matrix<T, C, R>& m) {
  return m * s;
}
#define M2V_MATRIX_TYPEDEF(T, N, M) typedef matrix<T, N, M> T##N##x##M;
#define M2V_MATRIX_ROW(T, N)                                                                                           \
  M2V_MATRIX_TYPEDEF(T, N, 2)                                                                                          \
  M2V_MATRIX_TYPEDEF(T, N, 3)                                                                                          \
  M2V_MATRIX_TYPEDEF(T, N, 4)
#define M2V_MATRIX_ALL(T)                                                                                              \
  M2V_MATRIX_ROW(T, 2)                                                                                                 \
  M2V_MATRIX_ROW(T, 3)                                                                                                 \
  M2V_MATRIX_ROW(T, 4)
M2V_MATRIX_ALL(float)
M2V_MATRIX_ALL(half)
M2V_MATRIX_ALL(bfloat)
#undef M2V_MATRIX_ALL
#undef M2V_MATRIX_ROW
#undef M2V_MATRIX_TYPEDEF

// ---- simdgroup_matrix<T, 8, 8>, Apple fragment layout: lane -> (row, col0, col0 + 1), two elements per lane ----
METAL_FUNC int m2v_row(uint lane) { return (int)(((lane >> 4) & 1) * 4 + ((lane >> 1) & 3)); }
METAL_FUNC int m2v_col(uint lane) { return (int)(((lane >> 3) & 1) * 4 + (lane & 1) * 2); }
METAL_FUNC uint m2v_lane_of(int r, int c0) {
  return (uint)(((c0 >> 1) & 1) | ((r & 3) << 1) | (((c0 >> 2) & 1) << 3) | (((r >> 2) & 1) << 4));
}

template <typename T, int R, int C> struct simdgroup_matrix {
  vec<T, 2> el;
  METAL_FUNC simdgroup_matrix() = default;
  // Copy operations are __private-qualified: these matrices are thread-private, and the implicit operations would
  // take their argument through the generic address space, which clspv cannot rebuild for whole-matrix accesses.
  METAL_FUNC simdgroup_matrix(const __private simdgroup_matrix& o) : el(o.el) {}
  METAL_FUNC simdgroup_matrix(const simdgroup_matrix& o) : el(o.el) {}
  // Materialized temporaries carry no address space, so the copy operations need both spellings.
  METAL_FUNC __private simdgroup_matrix& operator=(const simdgroup_matrix& o) __private {
    el = o.el;
    return *this;
  }
  METAL_FUNC __private simdgroup_matrix& operator=(const __private simdgroup_matrix& o) __private {
    el = o.el;
    return *this;
  }
  // Metal: simdgroup_matrix(value) is the diagonal matrix value * I.
  METAL_FUNC simdgroup_matrix(T v) {
    const uint lane = get_sub_group_local_id();
    const int r = m2v_row(lane), c = m2v_col(lane);
    el[0] = r == c ? v : T(0);
    el[1] = r == c + 1 ? v : T(0);
  }
  METAL_FUNC __private vec<T, 2>& thread_elements() __private { return el; }
};

// MSL 3.1: every fragment element set to v (unlike the constructor, which is the diagonal value * I).
template <typename T, int N> METAL_FUNC simdgroup_matrix<T, N, N> make_filled_simdgroup_matrix(T v) {
  simdgroup_matrix<T, N, N> r;
  r.thread_elements()[0] = v;
  r.thread_elements()[1] = v;
  return r;
}

// This shim implements the 8x8 per-lane fragment layout only.
template <typename T, int Cols, int Rows> METAL_FUNC simdgroup_matrix<T, Cols, Rows> make_filled_simdgroup_matrix(T v) {
  static_assert(Cols == 8 && Rows == 8, "metal2vk supports only 8x8 simdgroup matrices");
  simdgroup_matrix<T, Cols, Rows> r;
  r.thread_elements()[0] = v;
  r.thread_elements()[1] = v;
  return r;
}

#ifdef M2V_NO_COOPMAT
// Portable fallback: D = A * B + C with subgroup shuffles in the Apple fragment layout (any 32-wide subgroup device).
template <typename TD, typename TA, typename TB, typename TC>
METAL_FUNC void simdgroup_multiply_accumulate(
    simdgroup_matrix<TD, 8, 8>& D, simdgroup_matrix<TA, 8, 8>& A, simdgroup_matrix<TB, 8, 8>& B,
    simdgroup_matrix<TC, 8, 8>& Cm) {
  const uint lane = get_sub_group_local_id();
  const int row = m2v_row(lane);
  const int col = m2v_col(lane);
  float acc0 = (float)Cm.el[0];
  float acc1 = (float)Cm.el[1];
  for (int k = 0; k < 8; k++) {
    const float a = sub_group_shuffle((float)A.el[k & 1], m2v_lane_of(row, k & ~1));
    const uint src_b = m2v_lane_of(k, col);
    const float b0 = sub_group_shuffle((float)B.el[0], src_b);
    const float b1 = sub_group_shuffle((float)B.el[1], src_b);
    acc0 = ::fma(a, b0, acc0);
    acc1 = ::fma(a, b1, acc1);
  }
  D.el[0] = (TD)acc0;
  D.el[1] = (TD)acc1;
}
#else
