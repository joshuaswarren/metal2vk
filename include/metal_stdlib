// Metal's select: elementwise cond ? t : f. OpenCL's builtin select needs the condition elements to be as wide as the
// value elements; Metal's boolN (the shim's vec<short, N>) is accepted against any vector, so this overload covers the
// narrow-condition calls the builtin rejects. Same-width conditions keep matching the builtin with the same result.
template <typename T, int N, typename C> METAL_FUNC vec<T, N> select(vec<T, N> f, vec<T, N> t, vec<C, N> cond) {
  vec<T, N> r;
  for (int i = 0; i < N; i++) r[i] = cond[i] ? t[i] : f[i];
  return r;
}
template <typename T, typename C> METAL_FUNC T select(T f, T t, C cond) { return cond ? t : f; }
